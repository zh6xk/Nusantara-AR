  m_EditorClassIdentifier: Assembly-CSharp::CrownARController
  faceManager: {fileID: 1864876463}
  faceDetectorModel: {fileID: 5022602860645237092, guid: 61cf425d48095da4085a254f4f9fefa7, type: 3}
  arFaceHatOffset: {x: 0, y: 0.055, z: -0.02}
